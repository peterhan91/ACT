# Copy to .env and `source .env` (or set in your shell) before running.
# The defaults inside the code point at the release placeholder layout
# (/path/to/ACT, /path/to/data...); these overrides let everything run on
# your machine. ACT_REPO is the root of this repository.

# --- Repo roots --------------------------------------------------------------
export ACT_REPO="/path/to/ACT"
export CLIP3D_CONCEPTS_ROOT="${ACT_REPO}/analysis"

# --- LLM concept-encoding ONLY needs the JSONL extracts + a GPU --------------
# (get_embed_ct.py: SFR/Harrier embedding has no 3D-CLIP dependency at all)
export CONCEPT_JSONL_FILES="${CLIP3D_CONCEPTS_ROOT}/ctrate_concepts.jsonl,${CLIP3D_CONCEPTS_ROOT}/merlin_concepts.jsonl"
export CONCEPT_BANK_PKL="${CLIP3D_CONCEPTS_ROOT}/concept_bank.pkl"

# --- 3D-CLIP text-tower step (optional in get_embed_ct.py: --skip_clip) ------
# Only needed if you want to embed concepts with our 3D-CLIP text encoder
# in addition to / instead of the LLM encoders. The model code ships in this
# repo under model/.
export CLIP3D_REPO="${ACT_REPO}/model"
# CLIP3D_EVAL_REPO points at the clip_3d_eval loader (configs.json + eval_all.py).
# That loader is not yet in this release (see README Known gaps); until it is
# added at analysis/eval/, set this to your own copy.
# Uncomment only to point elsewhere:
# export CLIP3D_EVAL_REPO="${CLIP3D_CONCEPTS_ROOT}/eval"
# export CLIP3D_CONFIGS="${CLIP3D_EVAL_REPO}/configs.json"
export CLIP3D_BEST="clip_3d_ctrate_merlin_v1"

# --- Image-side experiments (exp_*_ct.py) need the H5 + label CSVs -----------
export CT_DATA_ROOT="/path/to/h5_root"              # contains ctrate_*.h5, inspect_*.h5
export CT_LABELS_ROOT="/path/to/label_csvs"         # contains ct_rate/ and inspect/

# --- Phenotype-label evaluation only ----------------------------------------
export INSPECT_PHENOTYPE_ROOT="/path/to/phenotype_labels/per_ct"

# --- Hugging Face ------------------------------------------------------------
# Put REAL tokens in .env (gitignored), not here. HF_TOKEN defaults to the read
# token (least privilege); a write token is only needed to PUSH artifacts.
export HF_TOKEN_READ="hf_read_token_here"
export HF_TOKEN_WRITE="hf_write_token_here"
export HF_TOKEN="${HF_TOKEN_READ}"
# Release artifacts (model weights etc.) live at
# https://huggingface.co/peterhan91/clip_3d_ct
export HF_ARTIFACTS_REPO="your-org/your-artifacts-repo"
